<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 应用内自更新需要拉起系统安装器。注意：声明这个权限**不等于**能装 ——
         Android 8.0 起还要求用户在「安装未知应用」里对本应用单独授权，
         没授权时 Installer 会直接拒绝，所以 UpdateDownloader 里要能识别并引导过去。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.VideoShell">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SiteActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <!-- 搜索结果二级页（v1.0.50）：左侧站源栏 + 右侧结果。
             ⚠️ 声明 configChanges 是为了**不重建**（重建会把结果丢掉、再搜一遍），
             所以列数（竖 2 / 横 4）必须在 onConfigurationChanged 里重排 ——
             只在 onCreate 排一次的话，转一次屏就错位。 -->
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <activity
            android:name=".ui.DetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FavActivity"
            android:exported="false" />

        <!-- 网盘账号（v1.0.65）：内嵌 WebView 登录夸克/UC 等网盘，凭据只存本机。
             configChanges 必须带上 orientation|screenSize|keyboardHidden ——
             登录页是桌面版页面，用户很容易转屏；不声明的话转屏会重建 Activity，
             AlertDialog 里的 WebView 连同已填的密码一起消失，用户只会以为"登录坏了"。 -->
        <activity
            android:name=".ui.DriveAccountsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- 调试校准模式：用 WebView 打开站点，引导用户点分类 / 影片 / 分集，把规则固化下来 -->
        <!-- 网盘登录页（v1.0.65）：全屏 WebView，给扫码用。
             必须是**独立 Activity + 全屏**：网页版登录默认就是扫码，二维码塞进
             对话框会被压到扫不动（原来 DriveAccountsActivity 就是这么干的）。
             configChanges 与 DriveAccountsActivity 一致 —— 桌面版登录页很容易被转屏，
             不声明就会重建，正在走的扫码流程直接断掉。 -->
        <activity
            android:name=".ui.DriveLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ui.CalibrateActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity
            android:name=".player.SniffActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.VideoShell.Player"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode" />

        <!-- 投屏设备选择（新增） -->
        <activity
            android:name=".player.CastActivity"
            android:exported="false"
            android:theme="@style/Theme.VideoShell" />

        <!-- 后台播放 + 媒体通知（FN-4） -->
        <service
            android:name=".player.MediaNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 自更新把 APK 交给系统安装器时，必须走 content:// ——
             Android 7.0 起用 file:// 外泄会直接抛 FileUriExposedException。
             authority 带包名，避免与其它应用撞名（多设备并存时确实会撞）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

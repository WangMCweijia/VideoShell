<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏覆盖（v1.0.45；v1.0.48 随浮岛化重算）。

  横屏时播放页底栏少一行：工具行（倍速/选集/静音/画面比例/旋转）会被
  PlayerActivity.applyBarRows() 并进主行，底栏 92dp = 离底 margin 10 + padding 8
  + 进度行 28 + 主行 46。
  ⇒ 让位 102dp（10dp 余量）。否则分集面板会被底栏压住一截。
-->
<resources>
    <dimen name="player_panel_clearance">102dp</dimen>
</resources>

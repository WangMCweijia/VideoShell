<?xml version="1.0" encoding="utf-8"?>
<!-- Dock 图标 / 文字色（v1.0.62）：
     选中 = 聚光琥珀（双主题同值 —— 亮 Dock 是墨底、暗 Dock 是黑场，用同一支亮琥珀）；
     未选中 = dock_inactive，**按各自 Dock 底色取值**（亮色墨底 6.3:1 / 暗色 5.0:1，均过 AA）。
     ⚠️ 不能沿用 text_hint：亮色 #6E7888 落在墨底只有 3.6:1，11sp 小字不达标。
     状态键是 state_selected（手写 Dock 由 View.setSelected 驱动，不再是 menu 的 checked）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/dock_active" android:state_selected="true" />
    <item android:color="@color/dock_inactive" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/island_gap"
        android:layout_marginTop="@dimen/island_gap"
        android:layout_marginEnd="@dimen/island_gap"
        android:background="@drawable/bg_glass_dark_bar"
        android:gravity="center_vertical"
        android:minHeight="@dimen/island_min_h"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/white" />

        <!-- 浏览模式专用：网页后退（真正的返回箭头）。只在 browse 时出现（默认 gone）。
             两个按钮的图标刻意区分开：左上角那个在浏览模式下会换成「×（关闭）」，
             否则两个一模一样的箭头挨在一起，用户没法预测按哪个会发生什么。 -->
        <ImageButton
            android:id="@+id/webBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/sniffer_title"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnCopy"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/sniffer_copy"
            android:textColor="@color/brand"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnToggleWeb"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/sniffer_hide_web"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <!--
      底部浮窗（v1.0.38 起可拖动 + 可收起）。

      为什么必须能收：这个页面是**用来看网页**的，而浮窗压在网页底部 ——
      很多站的「选集 / 下一集 / 线路切换 / 播放」按钮正好在那一带，
      用户点不到，症状是"这个网页的功能怎么用不了"。
      收起来只剩一行，既不挡操作，也还看得见抓了几个源。
    -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- 手柄行：**整行都能拖**（不要求用户按准那根细线），
             而且没拖动时按一下就等于收起/展开 —— 手指落点大、语义单一。 -->
        <LinearLayout
            android:id="@+id/panelHandle"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/panelGrip"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_marginStart="2dp"
                android:background="#66FFFFFF" />

            <TextView
                android:id="@+id/tvPanelBrief"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!--
              去广告开关（v1.0.52）。
              放在**手柄这一行**而不是展开区：拦截判据里有一条是推断（跨站 + 无手势 = 弹窗），
              万一错杀了本站的正常跳转，用户必须能立刻关掉它 —— 而那时浮窗多半是收起的。
            -->
            <TextView
                android:id="@+id/btnAdBlock"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/adblock_on"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPanelToggle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/sniff_panel_collapse"
                android:textColor="@color/brand"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 收起时整块隐藏（只留上面那一行） -->
        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pb"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="@color/brand" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/sniffer_running"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/sniffer_retry"
                    android:textColor="@color/brand"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- v1.0.37：把"这一页变成一个站源"的入口放在这里。
                 嗅探页是全 App 唯一能看到**真实网页**的地方（校准页只管点四步），
                 让用户"复制网址 → 返回 → 粘贴 → 识别"是把最顺的路堵上。 -->
            <TextView
                android:id="@+id/tvCurUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/webActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnGrab"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_brand"
                    android:gravity="center"
                    android:text="@string/sniffer_grab"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnCalib"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_dark"
                    android:gravity="center"
                    android:text="@string/sniffer_calib"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCandidates"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

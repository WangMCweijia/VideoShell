<?xml version="1.0" encoding="utf-8"?>
<!--
  调试校准模式：用 WebView 打开站点，分三步引导用户「点分类 → 点影片 → 点分集」，
  每一步都从真实点击里反推出这一类链接的形状，最后固化进站点配方。

  布局刻意保持"网页占大头"：用户是在网页里点东西，引导卡只占顶部一条。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/island_gap"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/island_gap"
        android:background="@drawable/bg_glass"
        android:gravity="center_vertical"
        android:minHeight="@dimen/island_min_h"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textSize="17sp" />

        <!--
          去广告开关（v1.0.52）。校准学的是"用户点的那个链接的形状"，而广告浮层会劫持这次
          点击 ⇒ 写进配方的是广告链接的形状（所有报错都是绿的，只有规则是错的）。
          所以默认拦，并且把这个开关摆在顶栏：万一错杀了本站的正常跳转，用户能立刻关掉。
        -->
        <TextView
            android:id="@+id/btnAdBlock"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/adblock_on"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/calib_restart"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stepCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!--
          ⚠️ 这三段的文字色**必须写死浅色**，不能用 @color/text_primary / text_hint：
          它们坐在 bg_panel（固定深色玻璃）上，而亮色模式下 text_primary 是深色 ——
          深字压深玻璃，等于什么都看不见（v1.0.48 顺手修掉的既有缺陷）。
          判断规则：容器背景不跟随主题 ⇒ 里面的文字色也不能跟随主题。
        -->
        <TextView
            android:id="@+id/tvStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF7AA8FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFE6EAF2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFB0B8C6"
            android:textSize="12sp" />

        <!--
          确定 / 重选。
          这两个按钮**始终可见** —— 上一版是"点完链接自动推进"，判据一否决就没有任何出路，
          用户被锁死在第一步。现在点击只「选中」，推进必须由用户按「确定」，
          所以按钮不能藏、也不能置灰（置灰等于又没反馈）。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSkip"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/calib_skip"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnReselect"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/calib_reselect"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_brand"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/calib_confirm_cat"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/pb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/amber_progress"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

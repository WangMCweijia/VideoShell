<?xml version="1.0" encoding="utf-8"?>
<!--
  站源浏览视图（首页与二级站源页共用）：
  标题行 + 搜索行 + 分类 chip 栏 + 分类提示行 + 影片网格 + 状态位。
  btnBack 默认隐藏 —— 首页不需要返回键，二级页由宿主打开。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ==================== 标题行（浮岛，v1.0.48） ====================
         从"贴边的通栏标题条"改成一块不与屏幕齐平的玻璃片：
         · 高度 wrap_content + minHeight，别写死 —— 浮岛靠内边距呼吸，写死高度会把内容挤扁
         · 背景 bg_glass 的 16dp 圆角与其余浮岛同源（@dimen/radius_lg），改一处全站跟着变 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/island_gap"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/island_gap"
        android:background="@drawable/bg_glass"
        android:gravity="center_vertical"
        android:minHeight="@dimen/island_min_h"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnCalib"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/calib"
            android:textColor="@color/brand"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDoctor"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/site_doctor"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnSearchToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <!-- 搜索行也收成一块浮岛：它与标题行是"同一个操作区"的两段，都浮起来才成套。
         padding 6dp 是为了让里面的输入框与岛边留出呼吸，不是装饰。 -->
    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/island_gap"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/island_gap"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm"
        android:visibility="gone">

        <EditText
            android:id="@+id/inputSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:importantForAutofill="no"
            android:background="@drawable/bg_input"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minWidth="72dp"
            android:text="@string/search"
            android:textSize="14sp" />

        <!-- 退出搜索（v1.0.50）。
             以前**没有任何**退出搜索的出口：唯一能回到分类浏览的是标题栏那枚放大镜，
             而它在搜索态下看起来仍然是"搜索"—— 没人知道再点一次是退出。
             用户的原话就是「搜索后无法退出搜索回到首页」。
             这里给一个语义明确的 ✕（关闭），不依赖用户去猜图标的第二种含义。
             它与返回键走的是同一个入口（SiteBrowser.exitSearch）⇒ 两条路不会不一致。 -->
        <ImageButton
            android:id="@+id/btnExitSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_exit"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <!-- FN-2：搜索历史下拉。搜索框聚焦且为空时弹出，点一项即回填并搜索 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_surface"
        android:maxHeight="220dp"
        android:visibility="gone" />

    <!-- 搜索范围（v1.0.37）：本站 / 全站 / 全网。
         单独占一行而不是塞进搜索框那一行 —— 搜索框在窄屏上已经要跟「搜索」按钮分宽度，
         再挤三个 chip 会把输入框压到看不见输入的字。 -->
    <LinearLayout
        android:id="@+id/scopeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/scopeSite"
            style="@style/ChipSmall"
            android:layout_marginEnd="6dp"
            android:text="@string/scope_site" />

        <TextView
            android:id="@+id/scopeAll"
            style="@style/ChipSmall"
            android:layout_marginEnd="6dp"
            android:text="@string/scope_all" />

        <TextView
            android:id="@+id/scopeWeb"
            style="@style/ChipSmall"
            android:layout_marginEnd="10dp"
            android:text="@string/scope_web" />

        <TextView
            android:id="@+id/tvScopeHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 搜索引擎（v1.0.38）：只在「全网」范围下出现。
         横滑而不是换行：引擎会越加越多，换行会把搜索区越撑越高、把网格挤下去；
         而"选哪个引擎"是个一次性的决定，藏在一行里滑一下完全够用。 -->
    <HorizontalScrollView
        android:id="@+id/engineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/engBaidu"
                style="@style/ChipSmall"
                android:layout_marginEnd="6dp"
                android:text="@string/engine_baidu" />

            <TextView
                android:id="@+id/engSogou"
                style="@style/ChipSmall"
                android:layout_marginEnd="6dp"
                android:text="@string/engine_sogou" />

            <TextView
                android:id="@+id/eng360"
                style="@style/ChipSmall"
                android:layout_marginEnd="6dp"
                android:text="@string/engine_360" />

            <TextView
                android:id="@+id/engBing"
                style="@style/ChipSmall"
                android:layout_marginEnd="6dp"
                android:text="@string/engine_bing" />

            <TextView
                android:id="@+id/engDdg"
                style="@style/ChipSmall"
                android:layout_marginEnd="10dp"
                android:text="@string/engine_ddg" />

            <!-- 关键词增强。与引擎并列而不是藏在设置里：它和"选哪个引擎"是同一个决定
                 （都是为了把结果压向能播的站），分开放用户就只会用到一半。 -->
            <TextView
                android:id="@+id/engSuffix"
                style="@style/ChipSmall"
                android:text="@string/engine_suffix_online" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 高度写死 46dp 而不是 wrap_content：分类是**异步**到达的，wrap_content 的 RecyclerView
         首次测量时 itemCount=0 → 高度为 0，在个别机型上之后即使 notifyDataSetChanged
         也不再重新撑开，表现就是"分类栏整条看不见、只剩最新"。固定高度从根上消除这种可能。 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCats"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="none" />

    <!-- 分类没解析出来时给个可操作的提示，而不是让分类栏静默消失 -->
    <LinearLayout
        android:id="@+id/catHintRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCatHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cat_only_home"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnCatRetry"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/cat_retry"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/tabDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVideos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="20dp" />

        <ProgressBar
            android:id="@+id/pb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/amber_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient"
    android:orientation="vertical">

    <!-- 原「图标 + 视频壳 + 版本号」这一行已移除（v1.0.26）：
         它占了整整一行高度，但信息量为零 —— 应用名在桌面图标上就有，版本号在「我的」页
         （tvVersionMine）也有一份。省下的这一行直接让首页内容上移。 -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ======================= 首页：默认站源浏览（分类+搜索，与二级站源页同一套视图） ======================= -->
        <LinearLayout
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                android:id="@+id/browserHome"
                layout="@layout/view_site_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvHomeState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="18dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ======================= 站源：添加入口 + 站点列表 ======================= -->
        <LinearLayout
            android:id="@+id/pageSites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/island_gap"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/island_gap"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="@dimen/island_pad_h">

                <!-- 排版 2.0（v1.0.60）：输入框与主按钮**同一行**（省一行高度，视线
                     "输入 → 确认"不打折）；次级动作（嗅探/浏览/管理）收成一行文字按钮；
                     导入/导出/合并/体检收进「管理」菜单 —— 4 个并排 38dp 小按钮热区不足
                     且与主操作抢视觉权重（设计稿 §5·站源页：1 主 + 3 次）。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/inputUrl"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:importantForAutofill="no"
                        android:background="@drawable/bg_input"
                        android:hint="@string/hint_url"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetect"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="104dp"
                        android:maxLines="1"
                        android:text="@string/btn_detect"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- 次级动作 = 描边芯片（v1.0.61）：纯文字按钮看着像标签不像按钮，
                     主次也不分 —— 统一描边小芯片与琥珀实底主按钮形成两级。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSniff"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:text="@string/btn_sniff"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:rippleColor="@color/glass_pressed"
                        app:strokeColor="@color/line"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBrowseWeb"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:text="@string/btn_browse_web"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:rippleColor="@color/glass_pressed"
                        app:strokeColor="@color/line"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:text="@string/site_manage"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:rippleColor="@color/glass_pressed"
                        app:strokeColor="@color/line"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayDirect"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_play_direct"
                    android:textColor="@color/amber_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:text="@string/sites_tip"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSites"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="20dp" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/empty_sites"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- ======================= 我的 ======================= -->
        <ScrollView
            android:id="@+id/pageMine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/mineContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/group_content"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_history"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/text_hint"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/line" />

                    <LinearLayout
                        android:id="@+id/rowFav"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_fav"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/text_hint"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/line" />

                    <!-- 网盘账号（v1.0.65）。放在「内容」这一组里，与历史/收藏并列 ——
                         它是"内容的来源"，不是设置项。右侧那格直接显示已登录几个盘：
                         网盘直链**不登录就取不到**，所以这行必须能一眼看出当前状态。 -->
                    <LinearLayout
                        android:id="@+id/rowDrives"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/row_drives"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDrivesHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/text_hint"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/group_play"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sw_auto_orient"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swAutoOrient"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sw_auto_next"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swAutoNext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sw_resume"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swResume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bg_play"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swBgPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/group_appearance"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dark_mode"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/tgDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/tgDarkSystem"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/dark_system"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_badge" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/tgDarkLight"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/dark_light"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_badge" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/tgDarkDark"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/dark_dark"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_badge" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/group_about"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_version"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVersionMine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/line" />

                    <!-- 检查更新（v1.0.54）。放在「版本」正下方是**刻意的**：
                         用户看到"当前 v1.0.53"之后，脑子里的下一个问题就是"有没有新的"。
                         右侧那格是结果位（已是最新 / 有新版本 / 检查失败），
                         不靠 toast —— 见 UpdateFlow 类注释第 3 条。 -->
                    <LinearLayout
                        android:id="@+id/rowUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_check_update"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvUpdateHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/line" />

                    <TextView
                        android:id="@+id/tvAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:padding="14dp"
                        android:text="@string/about_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <!-- ======================= 底部 Dock（v1.0.62 起手写，v1.0.49 起真正浮起） =======================
             ⚠️ 必须放在这个 FrameLayout **里面**（= 内容层的末尾），不能当成外层
             LinearLayout 的第二个子元素 —— 那样它是"流式占位"，内容区到它上方就
             截止了，列表永远延伸不到导航栏底下，玻璃再透也无物可透。
             这正是 v1.0.48 的真问题：用户看到的是"药丸旁边和下方还有一层遮罩"。
             现在它是浮在三个页面之上的一层，滚动时卡片会从它下面穿过。

             三件事同时做才成立：离屏幕左右各 10dp、离底（10dp + 系统栏）、圆角玻璃底。
             只做圆角不脱边 = 一块"圆角通栏"，仍是贴边的廉价感。
             ⚠️ v1.0.64 起是**真沉浸**：导航栏那一带不再是"填一条同色"，
             而是透明 + 露出画布（MainActivity.applyEdgeToEdge）。
             所以底距不能写死 island_gap，必须是 `island_gap + 系统栏高度`，
             否则 Dock 会贴到手势条上并把它压住 —— 见 applyNavClearance。
             （v1.0.63 及之前，那 10dp 空隙露出的是 bg_deep，靠"与
              navigationBarColor 同色"才没出现色带 —— 那是妥协，不是沉浸。）
             ⚠️ 浮起之后各列表必须自己让出高度（见 MainActivity.applyNavClearance）。
             让位要加在**列表自己的 paddingBottom** 上，不能加在容器上 ——
             加在容器上只会把内容整体上推，内容依旧不会从玻璃下面穿过。

             v1.0.62 为什么不再用 BottomNavigationView：它的 icon↔label 间距是库内
             固定值（约 4dp）、**没有对外属性可调** —— 用户反馈的"图标与文字挤在一起"
             就是它造成的，而此前两轮"调描边 / 加选中胶囊"也改不动整体观感。手写三格后
             图标 22dp / 间距 5dp / 栏高 64dp 全部是自有 Token，选中态改由
             View.setSelected 驱动（状态自动传播给子 ImageView/TextView，因此
             bg_nav_item 与 nav_item 两个 selector 都改判 state_selected）。
             ⚠️ 材质变过两次，别按 v1.0.62 的结论理解：
                v1.0.62 亮色 Dock 用过"墨岛"（深色），理由是白 Dock 压在暖纸画布上
                "永远只是一块白"。这个结论**是错的** —— 在亮色主题里放一块深色块
                等于主题反转，用户一眼就否掉了。
                v1.0.63 起：亮色 = 白面板、暗色 = 墨岛，各自取色（见 dock_* Token）。
                两种情况下的分层手段不同，这才是关键：
                  亮色靠 ①抬亮一档 + ②浅墨发丝线 + ③elevation 12dp 投影
                  暗色靠 ①提亮一档 + ②8% 白发丝线（黑场上不能再压暗）
                也就是说 v1.0.61 那版白面板之所以"只是一块白"，
                原因是它**只有 fill + stroke、没有投影**，边界没东西承担。
                加了三件套里的第三件之后，白面板不需要靠明度反转立住。
                v1.0.64 再补一件：亮色 Dock 也做成**半透明**（93% / 下段 88%），
                滚动的海报从下沿穿过时能看到它"透"出去。底一透，文字色的
                基准就变了 —— 选中/未选中都按最坏情况（深色内容正好在 Dock
                正后方）重算过，算式在 values/colors.xml 的 Dock 段注释里。
             ⚠️ @menu/menu_main 自本版起不再被引用（文件保留以便回退）。
             发包实测：zip 里 res/menu 条目已被资源收缩剔除，但 resources.arsc 的
             字符串池仍残留 "menu_main" 这个名字（字符串池不做逐条回收）——
             别据此以为"文件还在包里"。 -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_h"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/island_gap"
            android:layout_marginEnd="@dimen/island_gap"
            android:layout_marginBottom="@dimen/island_gap"
            android:background="@drawable/bg_glass_nav"
            android:elevation="12dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <!-- 三格结构完全一致：图标 + @dimen/dock_icon_gap + 文字，整组垂直居中。
                 选中态 = 该格 isSelected ⇒ bg_nav_item 出琥珀胶囊、nav_item 让图标
                 与文字转琥珀（状态从容器自动传播到子 View，不需要逐格设置）。 -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/dock_icon"
                    android:layout_height="@dimen/dock_icon"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_home"
                    app:tint="@color/nav_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dock_icon_gap"
                    android:text="@string/nav_home"
                    android:textColor="@color/nav_item"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/dock_icon"
                    android:layout_height="@dimen/dock_icon"
                    android:contentDescription="@string/nav_sites"
                    android:src="@drawable/ic_grid"
                    app:tint="@color/nav_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dock_icon_gap"
                    android:text="@string/nav_sites"
                    android:textColor="@color/nav_item"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabMine"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/dock_icon"
                    android:layout_height="@dimen/dock_icon"
                    android:contentDescription="@string/nav_mine"
                    android:src="@drawable/ic_person"
                    app:tint="@color/nav_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dock_icon_gap"
                    android:text="@string/nav_mine"
                    android:textColor="@color/nav_item"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

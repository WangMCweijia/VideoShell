<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 自带控制条关掉，改用自己的，功能能做得更全 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <com.videoshell.player.PlayerGestureLayout
        android:id="@+id/gesture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ==================== 顶部栏 ==================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivMute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_mute"
            android:padding="9dp"
            android:src="@drawable/ic_volume"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/ivResize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_resize"
            android:padding="9dp"
            android:src="@drawable/ic_resize"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/ivLock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_lock"
            android:padding="9dp"
            android:src="@drawable/ic_unlock"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/ivRotate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_rotate"
            android:padding="9dp"
            android:src="@drawable/ic_rotate"
            android:tint="@color/white" />
    </LinearLayout>

    <!-- ==================== 底部控制条 ==================== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/brand"
                android:splitTrack="false"
                android:thumbTint="@color/brand" />

            <TextView
                android:id="@+id/tvDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:gravity="end"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_prev"
                android:padding="10dp"
                android:src="@drawable/ic_prev"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivRew"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_rew"
                android:padding="10dp"
                android:src="@drawable/ic_rew"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_play"
                android:padding="12dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivFf"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_ff"
                android:padding="10dp"
                android:src="@drawable/ic_ff"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:padding="10dp"
                android:src="@drawable/ic_next"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="1.0x"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnEpisodes"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_episodes"
                android:padding="10dp"
                android:src="@drawable/ic_list"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- 锁定后唯一可点的东西 -->
    <ImageView
        android:id="@+id/ivUnlock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_hud"
        android:contentDescription="@string/player_unlock"
        android:padding="11dp"
        android:src="@drawable/ic_lock"
        android:tint="@color/white"
        android:visibility="gone" />

    <!-- ==================== 选集面板 ==================== -->
    <LinearLayout
        android:id="@+id/episodePanel"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/player_episodes"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pbBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />

    <!-- 出错时给出可操作的诊断信息，而不是只闪一下 toast -->
    <LinearLayout
        android:id="@+id/diagPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDiagTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/player_error_title"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="6"
            android:textColor="#CCFFFFFF"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDiagNext"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_next"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnDiagClose"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_close"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDiagSniff"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_sniff"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDiagRetry"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_retry"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 自带控制条关掉，改用自己的，功能能做得更全 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <com.videoshell.player.PlayerGestureLayout
        android:id="@+id/gesture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ==================== 顶部栏（深色玻璃浮岛，v1.0.48） ====================
         只放「回退 + 标题 + 与"看什么/发到哪"有关的入口」：
         画中画 / 字幕 / 投屏 / 分享。
         频率更高、纯播放控制的按钮（静音 / 画面比例 / 旋转）已下移到底部控制条的
         工具行 —— 顶栏太挤会让每枚图标都被迫缩小，反过来更难按。

         浮岛化改动：左右各离边 10dp、上离边 10dp、圆角玻璃底。
         ⚠️ 材质必须用 bg_glass_dark_bar（固定深色），不能用 bg_glass ——
            顶栏压在视频画面上，浅色模式下会变成"白玻璃 + 白字"，全看不见。
         ⚠️ 高度必须是 wrap_content + minHeight：`applyOverlayInsets` 会给它补上
         「挖孔 / 状态栏」的 padding，写死 52dp 的话 padding 会去挤内容
         （v1.0.26 的真事故：标题与图标被压成一条横带）。
         ⚠️ 这里的左右 padding 只留 4/8dp：insets 监听还会在**每一侧**再加一笔
             cutout 宽度，基础值给大了，横屏刘海机上图标会被推得离边很远。 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/island_gap"
        android:layout_marginTop="@dimen/island_gap"
        android:layout_marginEnd="@dimen/island_gap"
        android:background="@drawable/bg_glass_dark_bar"
        android:gravity="center_vertical"
        android:minHeight="@dimen/island_min_h"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivPip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pip"
            android:padding="9dp"
            android:src="@drawable/ic_pip"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/ivSubtitle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subtitle"
            android:padding="9dp"
            android:src="@drawable/ic_subtitle"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/ivCast"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cast"
            android:padding="9dp"
            android:src="@drawable/ic_cast"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:padding="9dp"
            android:src="@drawable/ic_share"
            android:tint="@color/white" />
    </LinearLayout>

    <!-- ==================== 底部控制条 ====================
         两种排布，由代码按方向切换（见 PlayerActivity.applyBarRows）：
           · 横屏（640dp+ 宽裕）：进度条一行 + 按钮一行 —— 10 枚按钮并排
           · 竖屏（360dp 宽放不下）：按钮自动分成两行
               行2 核心传输（上一集 / 后退 / 播放 / 前进 / 下一集）
               行3 工具与辅助（倍速 / 选集 / 静音 / 画面比例 / 旋转）

        浮岛化改动（v1.0.48）：左右各离边 10dp、离底 10dp、圆角深色玻璃底。
        背景挂在 bottomBar 本身而不是 btnRowMain 上 —— 横屏时工具行会被
        `applyBarRows()` 并进主行（btnRowTool 转 GONE），背景若挂在行上会跟着塌掉。

        ⚠️ 为什么不一律一行：竖屏 360dp 去掉左右 padding 只剩 340dp，10 枚按钮
         （44dp 起）并排需要 440dp+ —— 物理上塞不下。硬挤会把点击区压到 34dp 以下，
         比「多一行」严重得多。横屏才放得开。
         ⚠️ 行3 的成员清单在 Kotlin 侧（`TOOL_ROW_IDS`）：增删这一行的按钮必须两边同步，
         否则旋转回竖屏时它会留在第一行。
         ⚠️ 进度行高度必须 wrap_content + 时间文本自带 minWidth：`applyOverlayInsets`
         会给底栏补导航栏 padding，写死高度会把内容压扁（v1.0.26 的真事故）。
         ⚠️ 多出来的 10dp margin 已经算进 @dimen/player_panel_clearance，
            改这里的 margin 必须同步改那个 dimen（含 values-land），否则面板会被压住。 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/island_gap"
        android:layout_marginEnd="@dimen/island_gap"
        android:layout_marginBottom="@dimen/island_gap"
        android:background="@drawable/bg_glass_dark_bar"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <!-- 行1：进度（横竖屏都是独立一行） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/brand"
                android:splitTrack="false"
                android:thumbTint="@color/brand" />

            <TextView
                android:id="@+id/tvDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:gravity="end"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 行2：核心传输（横屏时工具行会并进这一行） -->
        <LinearLayout
            android:id="@+id/btnRowMain"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_prev"
                android:padding="10dp"
                android:src="@drawable/ic_prev"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivRew"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_rew"
                android:padding="10dp"
                android:src="@drawable/ic_rew"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_play"
                android:padding="12dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivFf"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_ff"
                android:padding="10dp"
                android:src="@drawable/ic_ff"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:padding="10dp"
                android:src="@drawable/ic_next"
                android:tint="@color/white" />
        </LinearLayout>

        <!-- 行3：工具与辅助（横屏时整体并入行2） -->
        <LinearLayout
            android:id="@+id/btnRowTool"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="1.0x"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnEpisodes"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_episodes"
                android:padding="10dp"
                android:src="@drawable/ic_list"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivMute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_mute"
                android:padding="9dp"
                android:src="@drawable/ic_volume"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivResize"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_resize"
                android:padding="9dp"
                android:src="@drawable/ic_resize"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/ivRotate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_rotate"
                android:padding="9dp"
                android:src="@drawable/ic_rotate"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 悬浮锁定键 ====================
         贴在屏幕右侧正中，脱离顶栏独立成层（圆形浮起样式）。
         ⚠️ 它必须跟着控制条一起显隐（见 setBarsVisible）：这个位置正好压在
         「右半屏上下滑调音量」的手势区上，常显会让那一段音量手势失效。
         锁定后本键隐去，同一位置换成 ivUnlock —— 位置不变，手不用重新找。 -->
    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_float_round"
        android:contentDescription="@string/player_lock"
        android:padding="11dp"
        android:src="@drawable/ic_unlock"
        android:tint="@color/white" />

    <!-- 锁定后唯一可点的东西（与 ivLock 同位置同样式） -->
    <ImageView
        android:id="@+id/ivUnlock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_float_round"
        android:contentDescription="@string/player_unlock"
        android:padding="11dp"
        android:src="@drawable/ic_lock"
        android:tint="@color/white"
        android:visibility="gone" />

    <!-- ==================== 选集面板 ====================
         高度 220dp + 让位（@dimen/player_panel_clearance）：
         竖屏底栏 124dp ⇒ 留 132dp；横屏底栏 82dp ⇒ 由 values-land 覆盖成 90dp。
         面板最多 220+132 = 352dp，压在 360dp 高的横屏机上也进得来。 -->
    <LinearLayout
        android:id="@+id/episodePanel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="@dimen/player_panel_clearance"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPanelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/player_episodes"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 顺序 / 倒序：站点给的分集顺序各家不同（有的 181→1 倒着给），
                 给用户一个自己摆正的开关。文案显示**当前**状态。 -->
            <TextView
                android:id="@+id/tvOrder"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/order_asc"
                android:textColor="@color/brand"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pbBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/amber_progress"
        android:visibility="gone" />

    <!-- 出错时给出可操作的诊断信息，而不是只闪一下 toast -->
    <LinearLayout
        android:id="@+id/diagPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/island_gap"
        android:layout_marginEnd="@dimen/island_gap"
        android:layout_marginBottom="@dimen/player_panel_clearance"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDiagTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/player_error_title"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="6"
            android:textColor="#CCFFFFFF"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDiagNext"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_next"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnDiagCopy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_copy"
                android:textColor="@color/brand"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDiagClose"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_close"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDiagSniff"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_dark"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_sniff"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDiagRetry"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_dark"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_error_retry"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

<resources>
    <!-- 暗色（默认） -->
    <color name="bg">#FF0B0D11</color>
    <color name="bg_deep">#FF06080B</color>
    <color name="surface">#FF171A21</color>
    <color name="surface_2">#FF1F2430</color>
    <color name="line">#FF262B36</color>
    <color name="brand">#FF3D7FFB</color>
    <color name="brand_dark">#FF2F66CC</color>
    <color name="text_primary">#FFF2F4F7</color>
    <color name="text_secondary">#FF9AA3AF</color>
    <color name="text_hint">#FF6B7480</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent_scrim">#99000000</color>
    <color name="ic_launcher_background">#FF0E1013</color>
    <!-- 体检 / 状态徽章（FN-6）：暗色下提亮，保证在深底上可读 -->
    <color name="ok">#FF3DD68C</color>
    <color name="bad">#FFFF6B6B</color>

    <!--
      磨砂玻璃（暗色）：同样是"半透明 + 顶部高光 + 描边"，但描边换成 16% 白 ——
      深底上白描边才看得见，跟亮色的深描边正好相反（两边必须各写一套，不能共用）。
      色相偏蓝黑（#151921 系）而不是纯黑：纯黑玻璃压在暖色光斑上会显脏。

      ⚠️ v1.0.49 把透明度降下来（72% → 65%、56% → 48%）：原来的 72% 几乎不透明，
      "磨砂看不出来"的病根就在这里。现在还能看清背后光斑的走向。
      ⚠️ 高光从 14% 提到 18%：顶部那道棱是让人眼读出"这是一块凸起的玻璃"的关键，
      太弱就会被当成"比背景亮一点的矩形"。
    -->
    <color name="glass_fill">#A6151921</color>
    <color name="glass_fill_2">#7A10141B</color>
    <color name="glass_stroke">#2BFFFFFF</color>
    <color name="glass_glow">#2EFFFFFF</color>
    <color name="glass_pressed">#CC1E232C</color>

    <!-- 边缘折射（v1.0.50，与 values/colors.xml 成对）：
         暗色下是"亮棱 + 内侧一道暗"，与亮色正好相反 —— 见亮色那边的说明。
         主光 44%、次光 14%、内线 18% 黑：主光要够亮才能读出顶部那道棱，
         次光必须明显更弱，否则四条边一样亮就变成"白框"而不是折射。 -->
    <color name="glass_edge_a">#70FFFFFF</color>
    <color name="glass_edge_b">#24FFFFFF</color>
    <color name="glass_edge_c">#2E000000</color>

    <!-- 环境光斑：v1.0.49 提高一档（24%/18%/12% → 40%/32%/22%）。
         深底上低 alpha 的蓝几乎不可见，原来那组数值在实测里就是不存在的。 -->
    <color name="ambient_1">#663D7FFB</color>
    <color name="ambient_2">#5212B5A6</color>
    <color name="ambient_3">#387C4DFF</color>
</resources>

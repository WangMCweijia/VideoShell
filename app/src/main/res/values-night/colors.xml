<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         暗场 Spotlight（UI 2.0 · 默认主题）。
         界面 = 一间暗场放映厅：黑场画布，海报是唯一发光体，
         面板是实底分层（e1/e2/e3），靠色阶 + 发丝线 + 投影建立层次，
         不再用半透明磨砂（零 blur）。
         glass_* 色名保留换值（退役期），理由见 values/colors.xml 头注。
         ============================================================ -->
    <!-- 画布：黑场，bg → bg_deep 竖向渐变 = 极淡 vignette -->
    <color name="bg">#FF0A0C10</color>
    <color name="bg_deep">#FF060709</color>
    <!-- 层级面板：e1 面板 / e2 卡片 / line = 8% 白发丝线 -->
    <color name="surface">#FF12161D</color>
    <color name="surface_2">#FF191E27</color>
    <color name="line">#14FFFFFF</color>
    <!-- info / 链接色（原 brand 蓝降级） -->
    <color name="brand">#FF5D95F7</color>
    <color name="brand_dark">#FF3E77D6</color>
    <color name="text_primary">#FFF2F4F7</color>
    <color name="text_secondary">#FFA8B0BC</color>
    <!-- 12sp 辅助字过 AA（4.6:1 on stage） -->
    <color name="text_hint">#FF7E8794</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent_scrim">#99000000</color>
    <color name="ic_launcher_background">#FF0E1013</color>
    <!-- 体检 / 状态徽章（FN-6） -->
    <color name="ok">#FF3DD68C</color>
    <color name="bad">#FFFF6B6B</color>

    <!-- 聚光琥珀：双主题唯一同值 Token —— "白天黑夜都是那束灯"。
         规则同亮色：琥珀上文字用 amber_ink，禁白字。 -->
    <color name="amber_hi">#FFFFC46B</color>
    <color name="amber">#FFE8862C</color>
    <color name="amber_dark">#FFD0731A</color>
    <color name="amber_ink">#FF201405</color>
    <color name="amber_text">#FFB87A10</color>
    <!-- 进度/滑杆专用：黑场上 #E8862C ≈ 5:1，直接用原琥珀 -->
    <color name="amber_progress">#FFE8862C</color>
    <!-- ============================================================
         底部 Dock（v1.0.62 · "墨岛"；v1.0.63 亮色改浅色面板，**暗色不动**）。
         暗色主题沿用 e1 面板 95%：黑场上把 Dock 再压暗 = 等于没有 Dock，
         只能反向"提亮一档 + 8% 白发丝线"把浮岛从黑场里分出来。
         ⚠️ v1.0.63 起两个主题的 Dock 是**不同材质**（亮=白面板、暗=墨岛），
            这是刻意的：亮色主题里放深色块 = 主题反转（用户实测反馈）。
            前提是各自的选中/未选中色都按自家底色取值 —— 见亮度注释。
         ============================================================ -->
    <color name="dock_fill">#F212161D</color>
    <color name="dock_fill_2">#F20E121A</color>
    <color name="dock_stroke">#14FFFFFF</color>
    <color name="dock_inactive">#FF7E8794</color>
    <color name="dock_active">#FFFFC46B</color>
    <color name="dock_pill">#24E8862C</color>
    <color name="dock_ripple">#14FFFFFF</color>

    <!-- 玻璃四层 → 实底材质兼容映射（退役期）：
         fill = e1 面板 88%（Dock 压在滚动内容上仍留一线暗影），
         stroke = 8% 白发丝线，glow/edge/ambient 退役置透明。 -->
    <color name="glass_fill">#E612161D</color>
    <color name="glass_fill_2">#E60F131B</color>
    <color name="glass_stroke">#14FFFFFF</color>
    <color name="glass_glow">#00000000</color>
    <!-- 按下态 = e3 提亮 -->
    <color name="glass_pressed">#FF222834</color>
    <color name="glass_edge_a">#00000000</color>
    <color name="glass_edge_b">#00000000</color>
    <color name="glass_edge_c">#00000000</color>
    <color name="ambient_1">#00000000</color>
    <color name="ambient_2">#00000000</color>
    <color name="ambient_3">#00000000</color>
</resources>

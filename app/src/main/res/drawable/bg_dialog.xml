<?xml version="1.0" encoding="utf-8"?><!--
  弹层底（UI 2.0「暗场 Spotlight」）：e1 实底 + 发丝线，圆角 20dp（radius_xl）。
  ⚠️ 必须配 UpdateFlow 里的 window 背景置透明一起用：AlertDialog 的 window 背景
     是主题给的圆角矩形，不置透明会出现"双层圆角/双层描边"。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/radius_xl" />
    <stroke
        android:width="1dp"
        android:color="@color/line" />
</shape>

<?xml version="1.0" encoding="utf-8"?><!--
  底部 Dock 条目背景（v1.0.62）：选中 = 琥珀胶囊，未选中 = 透明 + 涟漪。

  ⚠️ 状态键是 state_selected，**不是** state_checked —— Dock 从
     BottomNavigationView 换成手写三格后，没有 menu 的 checked 状态机，
     选中态由容器 View.setSelected 驱动；它会向下传播给子 ImageView/TextView，
     所以图标与文字的 tint/textColor selector 会同步进入选中态（无需逐个设置）。

  胶囊用 <inset> 内缩 8dp：贴满整格会变成"选中了一整格"而不是一枚药丸。
  圆角 16dp 与栏高 64dp 相配 —— 胶囊高 48dp，圆角再大就成椭圆了。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <ripple android:color="@color/dock_ripple">
            <item>
                <inset
                    android:insetBottom="8dp"
                    android:insetLeft="8dp"
                    android:insetRight="8dp"
                    android:insetTop="8dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="16dp" />
                        <solid android:color="@color/dock_pill" />
                    </shape>
                </inset>
            </item>
        </ripple>
    </item>

    <item>
        <ripple android:color="@color/dock_ripple">
            <item>
                <inset
                    android:insetBottom="8dp"
                    android:insetLeft="8dp"
                    android:insetRight="8dp"
                    android:insetTop="8dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="16dp" />
                        <solid android:color="#00000000" />
                    </shape>
                </inset>
            </item>
        </ripple>
    </item>
</selector>

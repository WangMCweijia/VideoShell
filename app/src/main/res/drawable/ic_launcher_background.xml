<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层（API 26+）。

  用品牌蓝的斜向渐变，而不是原来的近黑 #0E1013：
  近黑在深色壁纸上几乎看不见，桌面上只剩中间那枚小红三角 —— 这正是「图标比别人的小一圈」
  的真正原因（感知尺寸由背景铺满遮罩的程度决定）。铺满的亮蓝让整个遮罩都成为图标本体。

  渐变只在 API 26+ 生效（自适应图标本身就是 26+），旧版走 mipmap/ic_launcher.xml 的纯色版。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF5B93FF" />
                <item android:offset="1" android:color="#FF2352CC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- 磨砂玻璃 · 列表卡片（比浮岛小一档圆角，见 bg_glass 的层结构说明） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_fill_2"
                android:startColor="@color/glass_fill"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:centerY="0.18"
                android:endColor="#00000000"
                android:startColor="@color/glass_glow"
                android:type="linear" />
        </shape>
    </item>

    <!-- 砂质层（v1.0.49）：必须长在玻璃片**自己**身上。只靠 bg_ambient 的颗粒是不够的
         —— 玻璃有 65% 不透明度，背景的颗粒透过来只剩三成，等于没有。 -->
    <item android:drawable="@drawable/glass_grain" />

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <solid android:color="#00000000" />
            <stroke
                android:width="@dimen/glass_stroke_w"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>

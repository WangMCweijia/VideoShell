<?xml version="1.0" encoding="utf-8"?>
<!--
  输入框底（网址 / 搜索框）。v1.0.48 起改为玻璃凹槽：

  输入框要的是"能看出边界但又不抢戏"，所以取**更透**的一档玻璃填充
  （glass_fill_2 = 只有常态的 60% 左右）＋ 一圈描边来划界。
  ⚠️ 不要给它加顶部高光：高光属于"凸起"语义，输入框是凹下去的，
     凸一块凹一块会让人以为输不进去。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_fill"
        android:startColor="@color/glass_fill_2"
        android:type="linear" />
    <corners android:radius="@dimen/radius" />
    <stroke
        android:width="@dimen/glass_stroke_w"
        android:color="@color/glass_stroke" />
</shape>

<?xml version="1.0" encoding="utf-8"?><!--
  浮岛 · 大面板（v1.0.48 起）。

  ⚠️ UI 2.0「暗场 Spotlight」（v1.0.59/60）起材质 = 实底分层 + 发丝线 + 投影：
     glass_* 色名保留换值（见 values/colors.xml 头注），棱光/光斑/砂质颗粒
     （glass_grain，v1.0.60 退役 —— 实底下颗粒只会把面板糊脏）全部退场。
     层名沿用玻璃时代的历史叫法，读时按"实底面板"理解。

  现存层叠，顺序不能反（后画的在上面）：
    ① 主体      glass_fill → glass_fill_2（实底面板，亮暗各一套值）
    ② 顶部高光  glass_glow = 透明（退役，画出为空）
    ③ 1px 描边  glass_stroke（发丝线）

  ⚠️ centerY 是 API 24+ 才认的属性；低版本按 0.5 处理。不会崩、不会发白。
  ⚠️ 各层必须写**同一个** corners，否则描边和填色会错位出双圆角。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_fill_2"
                android:startColor="@color/glass_fill"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:centerY="0.18"
                android:endColor="#00000000"
                android:startColor="@color/glass_glow"
                android:type="linear" />
        </shape>
    </item>


    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_lg" />
            <solid android:color="#00000000" />
            <stroke
                android:width="@dimen/glass_stroke_w"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>

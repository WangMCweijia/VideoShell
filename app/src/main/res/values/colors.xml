<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         白昼放映室（UI 2.0 · 暗场 Spotlight 的亮色主题）
         材质逻辑从"磨砂玻璃"换成"实底分层 + 发丝线 + 投影"：
           深度靠色阶与描边承担，不再依赖半透明（零 blur，低端机友好）。
         ⚠️ glass_* 色名全部保留、只换值 —— 十几个 drawable（bg_glass/bg_surface/
            bg_chip/bg_input…）都引用这些名字，改名会全线炸。玻璃棱（glass_edge_*）
            与背景光斑（ambient_*）在本材质里退役，统一置透明，引用它们的层
            画出来就是空操作，不需要动 drawable。
         ============================================================ -->
    <!-- 画布：暖纸，上亮下深（vignette 保留，光源在"天的方向"） -->
    <color name="bg">#FFF6F5F2</color>
    <color name="bg_deep">#FFEFEDE6</color>
    <!-- 面板 e1（实白）/ 卡面 e2（微暖）/ 按压 e3（压暖提亮） -->
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_2">#FFEFEDE8</color>
    <color name="line">#FFE2DFD8</color>
    <!-- info / 链接色（原 brand 蓝降级，不再承载主强调） -->
    <color name="brand">#FF3E77D6</color>
    <color name="brand_dark">#FF2F5BA8</color>
    <color name="text_primary">#FF1A1C20</color>
    <color name="text_secondary">#FF4E5866</color>
    <!-- 12sp 辅助字也过 AA（4.6:1） -->
    <color name="text_hint">#FF6E7888</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent_scrim">#99000000</color>
    <color name="ic_launcher_background">#FF0E1013</color>
    <!-- 体检 / 状态徽章（FN-6） -->
    <color name="ok">#FF1E9E5A</color>
    <color name="bad">#FFD64545</color>

    <!-- ============================================================
         聚光琥珀 —— 全 App 唯一高饱和强调色（UI 2.0）。
         amber 渐变只做"光"：进度条 / 选中芯片 / 主按钮 / 导航选中。
         ⚠️ 琥珀上永远用 amber_ink 深墨文字（白字只有 2.1:1，禁用）；
         ⚠️ 琥珀做亮底**文字**时必须用 amber_text #B87A10
            （#E8940F 在白底 2.4:1，只许当图形色）。
         ============================================================ -->
    <color name="amber_hi">#FFFFC46B</color>
    <color name="amber">#FFE8862C</color>
    <color name="amber_dark">#FFD0731A</color>
    <color name="amber_ink">#FF201405</color>
    <color name="amber_text">#FFB87A10</color>
    <!-- 进度/滑杆专用：亮底需要 ≥3:1 的图形对比度，故压深一档 -->
    <color name="amber_progress">#FFC9830F</color>
    <!-- 导航选中胶囊底：琥珀 12% 面积色（旧值，面板类保留引用） -->
    <color name="amber_pill">#1FE8862C</color>

    <!-- ============================================================
         底部 Dock（v1.0.63 · 亮色改回**浅色实体面板**）。
         v1.0.62 曾把亮色 Dock 做成"墨岛"（#1B2028），理由是白 Dock 压在
         暖纸画布上"永远只是一块白"。这个判断是错的：**亮色主题里放一块
         深色块 = 主题反转**，观感上就是"这不该是这样"（实测反馈原话）。
         「分层」的正确来源不是明度反转，而是三者叠加：
            ① 抬亮一档 —— 白 #FFFFFF 压在暖纸 #F6F5F2 之上（漫反射顶面）
            ② 发丝线描边 —— 浅墨 #D9D5CA 勾出边界（与全 App 面板同源）
            ③ elevation 12dp 投影（activity_main.xml，LayerDrawable 圆角 outline）
         暗色主题**保持墨岛**：黑场上只能靠"提亮一档 + 白发丝线"分层。
         两者是同一设计意图（把 Dock 从画布里分出来）的两种主题表达。
         ⚠️ 选中/未选中色必须按**自家底色**取，两个主题各算一遍：
            亮色白底：dock_inactive #64707F 5.0:1、dock_active #9E6709 4.7:1
            暗色黑场：dock_inactive #7E8794 5.0:1、dock_active #FFC46B（见 night）
         ⚠️ 两支琥珀是**故意不同**的，不要"统一"：亮琥珀 #FFC46B 在白底
            只有 1.9:1（连图形门槛都到不了），烫金必须压深到 #9E6709 才过 AA；
            反过来 #9E6709 落在黑场上又看不见。
         ============================================================ -->
    <color name="dock_fill">#FFFFFFFF</color>
    <color name="dock_fill_2">#FFF9F7F3</color>
    <color name="dock_stroke">#FFD9D5CA</color>
    <color name="dock_inactive">#FF64707F</color>
    <color name="dock_active">#FF9E6709</color>
    <color name="dock_pill">#2BE8862C</color>
    <color name="dock_ripple">#14000000</color>

    <!-- 玻璃四层 → 实底材质的兼容映射（色名退役期，引用方不用改）：
         fill/fill_2 = 实白面板（底部留一丝暖差当"漫反射"残影），
         stroke = 发丝线（v1.0.61 压深一档：#E2DFD8 在暖纸上几乎看不见，
         Dock/面板的边界感全靠它）。 -->
    <color name="glass_fill">#FFFFFFFF</color>
    <color name="glass_fill_2">#FFF9F7F3</color>
    <color name="glass_stroke">#FFD9D5CA</color>
    <color name="glass_glow">#00000000</color>
    <!-- 按下态 = e3 压暖（触感与暗色的"提亮"等价） -->
    <color name="glass_pressed">#FFF1EFE9</color>
    <color name="glass_edge_a">#00000000</color>
    <color name="glass_edge_b">#00000000</color>
    <color name="glass_edge_c">#00000000</color>
    <color name="ambient_1">#00000000</color>
    <color name="ambient_2">#00000000</color>
    <color name="ambient_3">#00000000</color>
</resources>

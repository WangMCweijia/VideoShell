<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         字号体系（UI-1）：集中定义，避免 16/13/12/11/10sp 散落各处。
         badge / 集数等小字统一 ≥ 11sp，保证可读。
         ============================================================ -->
    <dimen name="text_title">16sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_sub">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_badge">11sp</dimen>

    <!-- ============================================================
         间距 / 尺寸（UI-3）：卡片内边距、网格间距、控件高度集中管理。
         ============================================================ -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">6dp</dimen>
    <dimen name="space_md">8dp</dimen>
    <dimen name="space_lg">14dp</dimen>
    <dimen name="space_xl">18dp</dimen>
    <dimen name="card_padding">5dp</dimen>
    <!-- 影片卡片之间的缝（v1.0.49：4 → 6dp）。卡片圆角是 16dp，缝太窄时相邻两个
         圆角几乎贴在一起，远看像"一坨连在一起的卡片"，呼吸感全无。 -->
    <dimen name="grid_gap">6dp</dimen>
    <!-- 分集格子之间的缝：**必须比 grid_gap 小**，所以 v1.0.49 单独拆出一档。
         分集是 5 列密排、格子本身只有约 68dp 宽，缝每多 1dp 就吃掉文字区 2dp ——
         竖屏 5 列下 4→6dp 会让每格少放半个汉字，正好落在这个功能最吃紧的地方。
         两者场景完全不同，不要合并成一个值。 -->
    <dimen name="episode_gap">4dp</dimen>
    <dimen name="episode_min_h">38dp</dimen>
    <dimen name="poster_height">136dp</dimen>
    <!-- 海报纵横比（UI-2）：宽度 × 此系数 = 高度（≈ 1:1.4 竖版海报） -->
    <item name="poster_ratio" type="fraction">140%</item>

    <!-- ============================================================
         圆角尺度（UI-5）：统一一套，避免 16/14/8/4 各自为政。
         v1.0.48 起补上「浮岛」这一档（radius_lg/xl/hero）：
         方案 A 的所有浮岛（顶栏 / 底栏 / 导航 / 面板）都从这里取，
         不要在各 layout 里写死 16dp —— 那样调一次要改十几个文件。
         ============================================================ -->
    <dimen name="radius">12dp</dimen>
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_xs">6dp</dimen>
    <dimen name="radius_chip">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">20dp</dimen>

    <!-- ============================================================
         浮岛尺度（v1.0.48 · UI 方案 A）
         浮岛 = 不与屏幕边齐平的圆角玻璃片。四个值必须成套用：
           island_gap    浮岛到屏幕边 / 浮岛之间的呼吸距离
           island_pad_h  浮岛内部左右留白
           island_pad_v  浮岛内部上下留白
           island_min_h  浮岛最小高度（低于此值按钮热区会被压到 44dp 以下）
         ⚠️ 浮岛一旦加 margin，`applyOverlayInsets` 补的 left/right padding 会
         再叠一次 —— 播放页顶底栏的左右 padding 基础值因此从 4/8dp 起算，别加大。
         ============================================================ -->
    <dimen name="island_gap">10dp</dimen>
    <dimen name="island_pad_h">14dp</dimen>
    <dimen name="island_pad_v">10dp</dimen>
    <dimen name="island_min_h">52dp</dimen>
    <dimen name="glass_stroke_w">1dp</dimen>

    <!-- ============================================================
         底部 Dock（v1.0.62 起手写，不再用 BottomNavigationView）。
         64dp = 上 10 + 图标 22 + 图标文字间距 5 + 文字 ~17 + 下 10。
         ⚠️ 为什么不用 BottomNavigationView：它的 icon↔label 间距是库内
            固定值（约 4dp），**没有对外属性可调**，用户反馈的"图标与文字
            挤在一起"正是它造成的。手写三格后三项尺寸全是自有 Token，
            并且顺带能做出"选中胶囊包住整格"这种库做不到的形态。
         ⚠️ 改 dock_h 不用同步任何地方：各列表的让位高度是 applyNavClearance
            实测 Dock 高度算出来的（不是写死）。
         ============================================================ -->
    <dimen name="dock_h">64dp</dimen>
    <dimen name="dock_icon">22dp</dimen>
    <dimen name="dock_icon_gap">5dp</dimen>

    <!-- 平板适配（UI-3）：values-sw600dp 里覆盖这套，手机沿用默认 -->
    <dimen name="surface_padding">14dp</dimen>

    <!-- ============================================================
         搜索结果页左侧站源栏宽度（v1.0.50）。
         76dp 是**反算**出来的：竖屏 360dp 减去左右 island_gap 与中间 8dp 缝，
         留给结果区 256dp；结果区内部再扣掉 10+10 的列表 padding 与两列之间 6dp 缝，
         每张卡片正好 ~115dp —— 与首页 3 列的卡片宽度同档，
         所以同一条影片在两个页面上的封面大小一致，切换过去不会有"缩小了"的错觉。
         加宽一档（88dp）就会把卡片压到 104dp 以下，观感立刻变差。
         ============================================================ -->
    <dimen name="search_rail_w">76dp</dimen>

    <!-- ============================================================
         播放页底栏让位高度（v1.0.45，v1.0.48 随浮岛化重算）：
         分集面板 / 诊断面板要浮在底栏之上。
         竖屏底栏 = 离底 margin 10 + padding 8 + 进度行 28 + 主行 46 + 工具行 42 = 134dp
         ⇒ 留 144dp（10dp 余量）。
         ⚠️ 横屏底栏少一行（工具行并进主行）= 92dp，必须用 values-land 覆盖成 102dp，
         否则分集面板会被底栏压住一截。
         ⚠️ 改 activity_player 里 bottomBar 的 margin/padding/行高，必须同步改这里 + values-land。
         ============================================================ -->
    <dimen name="player_panel_clearance">144dp</dimen>
</resources>
